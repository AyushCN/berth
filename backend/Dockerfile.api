# Build stage
# Must be >= the `go` directive in go.mod (1.26.3), otherwise the build fails
# with "go.mod requires go >= 1.26.3".
FROM golang:1.26-alpine AS builder

# git is needed for `go mod download` over VCS-backed modules. The C toolchain
# is not: the prediction/ONNX stack that required CGO has been removed, so the
# binaries are pure Go and the build is both faster and reproducible.
RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o berth-api ./cmd/api

# Runtime stage
FROM alpine:3.20

RUN apk add --no-cache ca-certificates git curl bash

WORKDIR /app

COPY --from=builder /app/berth-api /usr/local/bin/

RUN mkdir -p /app/workspaces

EXPOSE 8080

ENTRYPOINT ["berth-api"]
