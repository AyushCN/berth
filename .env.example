# Core Environment Settings
ENV=development

# Backend Configuration
MODE=api
PORT=8080

# Database Configuration
DATABASE_URL=postgres://berth:berth@localhost:5432/berth?sslmode=disable
REDIS_URL=redis://localhost:6379

# Security & Auth Secrets
JWT_SECRET=replace_me_with_a_secure_random_string_at_least_32_chars
ENCRYPTION_KEY=replace_me_with_hex_generated_key_exactly_32_chars

# GitHub OAuth (required for production)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Docker Runtime Settings
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_NETWORK=berth
TRAEFIK_DOMAIN=localhost

# Workspace Directory
WORKSPACE_ROOT=/home/swordrookie/.local/state/berth/workspaces